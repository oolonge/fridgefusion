EXPORT_ARCH_ARGS = $(foreach arch, $(if $(EXPORT_ARCHS), $(EXPORT_ARCHS), $(EXPORT_VALID_ARCHS)), -arch $(arch))
EXPORT__PRO_FILE_ = /Users/administrator/Desktop/FridgeFusion/libs/presentation/presentation.pro


first: all
####### Build rules

staticlib: ../../lib/$(TARGET)

../../lib/libpresentation.a: ui_mainwindow.h $(OBJECTS) $(OBJCOMP) 
	@test -d ../../lib/ || mkdir -p ../../lib/
	-$(DEL_FILE) ../../lib/$(TARGET)
	$(AR) $(DESTDIR)$(TARGET) $(OBJECTS)
	$(RANLIB) ../../lib/$(TARGET)


