FridgeFusion.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile FridgeFusion.pro

qmake_all: sub-libs-core-qmake_all sub-libs-utils-qmake_all sub-libs-infrastructure-qmake_all sub-libs-application-qmake_all sub-libs-presentation-qmake_all sub-app-qmake_all FORCE

make_first: sub-libs-core-make_first-ordered sub-libs-utils-make_first-ordered sub-libs-infrastructure-make_first-ordered sub-libs-application-make_first-ordered sub-libs-presentation-make_first-ordered sub-app-make_first-ordered  FORCE
all: sub-libs-core-all-ordered sub-libs-utils-all-ordered sub-libs-infrastructure-all-ordered sub-libs-application-all-ordered sub-libs-presentation-all-ordered sub-app-all-ordered  FORCE
clean: sub-libs-core-clean-ordered sub-libs-utils-clean-ordered sub-libs-infrastructure-clean-ordered sub-libs-application-clean-ordered sub-libs-presentation-clean-ordered sub-app-clean-ordered  FORCE
distclean: sub-libs-core-distclean-ordered sub-libs-utils-distclean-ordered sub-libs-infrastructure-distclean-ordered sub-libs-application-distclean-ordered sub-libs-presentation-distclean-ordered sub-app-distclean-ordered  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
install_subtargets: sub-libs-core-install_subtargets-ordered sub-libs-utils-install_subtargets-ordered sub-libs-infrastructure-install_subtargets-ordered sub-libs-application-install_subtargets-ordered sub-libs-presentation-install_subtargets-ordered sub-app-install_subtargets-ordered FORCE
uninstall_subtargets: sub-libs-core-uninstall_subtargets-ordered sub-libs-utils-uninstall_subtargets-ordered sub-libs-infrastructure-uninstall_subtargets-ordered sub-libs-application-uninstall_subtargets-ordered sub-libs-presentation-uninstall_subtargets-ordered sub-app-uninstall_subtargets-ordered FORCE

xcodeproj:
	@$(QMAKE) -spec macx-xcode "$(EXPORT__PRO_FILE_)"

sub-libs-core-check_ordered:
	@test -d libs/core/ || mkdir -p libs/core/
	cd libs/core/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/administrator/Desktop/FridgeFusion/libs/core/core.pro ) && $(MAKE) -f Makefile check
sub-libs-utils-check_ordered: sub-libs-core-check_ordered 
	@test -d libs/utils/ || mkdir -p libs/utils/
	cd libs/utils/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/administrator/Desktop/FridgeFusion/libs/utils/utils.pro ) && $(MAKE) -f Makefile check
sub-libs-infrastructure-check_ordered: sub-libs-utils-check_ordered 
	@test -d libs/infrastructure/ || mkdir -p libs/infrastructure/
	cd libs/infrastructure/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/administrator/Desktop/FridgeFusion/libs/infrastructure/infrastructure.pro ) && $(MAKE) -f Makefile check
